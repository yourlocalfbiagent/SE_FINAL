# ── ERP System (port 8080) ────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:5432/<dbname>
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

PORT=8080

# URL of the Admin service (used by ERP to call Admin APIs)
ADMIN_BASE_URL=http://localhost:8081

# JWT — must be at least 32 characters (SEC-901)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars //testing
